# ----------------------------------------------------------------------
# Uploads Directory Hardening - Block Script Execution
# ----------------------------------------------------------------------

# 1. Disable Directory Listing
Options -Indexes -ExecCGI

# 2. Disable PHP and Script Execution completely in this directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 3. Deny execution / direct access for any potential script extensions
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|bash|exe|bat|cmd|js|html|htm|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
